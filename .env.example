# HBT Studio — Biến môi trường mẫu
WORKSPACE_DIR=./workspace
LIBRARY_DIR=./library
ASSETS_DIR=./assets
MODELS_DIR=./models
DEFAULT_FPS=50
WHISPER_MODEL=auto
WHISPER_DEVICE=auto

# Gemini API
GEMINI_API_KEY=

# Kho Tài Nguyên Trực Tuyến (tùy chọn)
PIXABAY_API_KEY=
GIPHY_API_KEY=
FREESOUND_API_KEY=
# Voicemod Tuna SFX API Key (tùy chọn, dùng cho tìm & tải Meme SFX trong /library)
VOICEMOD_TUNA_API_KEY=

# Cloudflare Workers AI (tùy chọn, tự vẽ ảnh 2D trên HBT Core)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
